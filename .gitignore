# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ── .NET build artifacts (docs/critical-issues/15-no-ci-cd.md) ──
[Bb]in/
[Oo]bj/
.tools/
publish/
*.user

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.vs/
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.dll
*.pdb
*.cache

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.angular/
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
.vs/
# System files
.DS_Store
Thumbs.db

# ── Build logs & ad-hoc test payloads (Issue 15) ──
*.log
enq_*.json
frontend_build_*.txt
frontend_final_verification.txt
test-output.txt

# ── User secrets / environment-specific config never committed ──
appsettings.Local.json
# Audit issue #25: environment appsettings carry credentials — keep only
# templated appsettings.json tracked; per-environment variants live in
# user secrets / environment variables.
SchoolManagementApp.Api/appsettings.Development.json
SchoolManagementApp.Api/appsettings.Production.json

# E2E/testing session tokens (audit issue #25)
e2e_token.txt
.dev_token.tmp
# Headless-Chrome verification profiles (never commit)
.chrome-*/

# Dev token/session scratch (generated by scripts/forge-superadmin-token.mjs)
login_resp.json
superadmin_token.txt
*.log
