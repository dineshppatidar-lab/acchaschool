                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"2024-2025\",\n  \"startDate\": \"2024-04-01T00:00:00\",\n  \"endDate\": \"2025-03-31T23:59:59\",\n  \"isActive\": true,\n  \"isCurrent\": true\n}"
            },
            "url": {
